PORT=8080
# Local Postgres from compose.local.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgres://postgres:change-me@127.0.0.1:5433/openfile-go?sslmode=disable"

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=5d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=15d

# S3-compatible storage. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://127.0.0.1:9000. AWS S3: leave STORAGE_ENDPOINT empty.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=change-me
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
