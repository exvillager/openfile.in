PORT=8080
# Local Postgres from compose.local.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgres://postgres:change-me@127.0.0.1:5434/openfile-go?sslmode=disable"

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=5d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRY=15d

# S3-compatible storage. R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO: http://127.0.0.1:9100. AWS S3: leave STORAGE_ENDPOINT empty.
# Local MinIO from compose.local.yml (secret key needs 8+ characters):
STORAGE_ENDPOINT=http://127.0.0.1:9100
STORAGE_REGION=us-east-1
STORAGE_BUCKET=openfile
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me-too
