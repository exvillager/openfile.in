{
   "name": "backend",
   "module": "index.ts",
   "type": "module",
   "private": true,
   "scripts": {
      "dev": "bun run --hot index.ts",
      "start": "bun run index.ts",
      "cf:dev": "bunx wrangler dev",
      "cf:deploy": "bunx wrangler deploy",
      "compile": "bun build ./index.ts --compile --bytecode --format=esm --outfile app-server",
      "dev:local": "DB_CLIENT=sqlite bun run --hot index.ts",
      "generate": "bunx drizzle-kit generate",
      "migrate": "bunx drizzle-kit migrate",
      "generate:sqlite": "bunx drizzle-kit generate --config=drizzle.sqlite.config.ts",
      "migrate:sqlite": "bunx drizzle-kit migrate --config=drizzle.sqlite.config.ts",
      "push:sqlite": "bunx drizzle-kit push --config=drizzle.sqlite.config.ts"
   },
   "devDependencies": {
      "@types/bun": "latest",
      "@types/pg": "^8.15.2",
      "drizzle-kit": "^0.31.5",
      "tsx": "^4.20.6",
      "typescript": "^5.8.2"
   },
   "peerDependencies": {
      "typescript": "^5"
   },
   "dependencies": {
      "@aws-sdk/client-s3": "^3.1118.0",
      "@aws-sdk/lib-storage": "^3.832.0",
      "@aws-sdk/s3-request-presigner": "^3.1118.0",
      "@neondatabase/serverless": "^1.0.2",
      "@types/jsonwebtoken": "^9.0.9",
      "@types/mime-types": "^2.1.4",
      "bullmq": "^5.55.0",
      "diesel-core": "^3.5.4",
      "dotenv": "^17.2.3",
      "drizzle-orm": "^0.45.2",
      "ejs": "^3.1.10",
      "google-auth-library": "^9.15.1",
      "ioredis": "^5.8.2",
      "jsonwebtoken": "^9.0.2",
      "k6": "^0.0.0",
      "mime-types": "^3.0.1",
      "nodemailer": "^9.0.1",
      "pg": "^8.16.3",
      "pino": "^9.9.5",
      "pino-daily-rotate-file": "^0.0.1",
      "pino-pretty": "^13.1.1",
      "pm2": "^7.0.4",
      "prom-client": "^15.1.3",
      "redis": "^5.5.6",
      "reflect-metadata": "^0.2.2",
      "resend": "^6.1.2",
      "uuidv7": "^1.0.2",
      "zod": "^3.25.13"
   }
}
